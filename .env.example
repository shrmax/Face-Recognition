# Application Host & Port
HOST=0.0.0.0
PORT=8000

# MongoDB Database Configuration
MONGO_URI=mongodb://localhost:27017/
MONGO_DB_NAME=face-recognition

# Datasets & Local Crop Storage Directory
VIDEOS_FOLDER=./Employee
CROP_DIR=./crops

# SCRFD Face Detection Parameters
DET_WIDTH=640
DET_HEIGHT=640
DET_THRESH=0.3
MAX_FACES=0  # 0 = unlimited face detection (100+ crowd faces per frame)

# 2-Tier Sampling & RTSP Watchdog
SAMPLE_FPS=6
WATCHDOG_TIMEOUT_SECONDS=5.0

# Face Quality & Blur Filter
MIN_BLUR_VAR=100.0
MIN_FACE_SIZE=60

# FAISS Similarity Search & Gallery
HIGH_CONF_THRESH=0.55
LOW_CONF_THRESH=0.40
MAX_GALLERY_EMBEDDINGS=5

# Cooldown & Retention Policy
VISIT_COOLDOWN_MINS=3
RETENTION_DAYS=30

# RTSP Stream URLs (comma-separated)
RTSP_STREAMS=rtsp://exelon:circuits@192.168.1.33:554/stream1